node_modules/
dist/
coverage/
*.tsbuildinfo
*.log

# Editor / OS junk
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
.idea/
.vscode/

# Local dev tooling — collector config, logs, secrets, pids
dev/
.env
.env.local

# Expo / RN generated artifacts in example apps.
# `expo prebuild` regenerates these from app.json + dependencies, so we
# don't commit them. Pin them in CI by checking in the lockfile only.
examples/*/ios/
examples/*/android/
examples/*/.expo/
examples/*/.eas/
examples/*/web-build/
examples/*/dist/

# Local Expo modules: keep the .kt / .swift / .podspec / package.json
# sources, but never commit gradle / xcodebuild build caches.
examples/*/modules/*/android/build/
examples/*/modules/*/ios/build/
examples/*/modules/*/ios/Pods/

# Scout SDK's own native module build output (gradle + CMake + xcodebuild).
# `android/` and `ios/` themselves are tracked source; only their build
# caches and CMake's `.cxx/` working dir need to be ignored.
android/build/
android/.cxx/
android/.gradle/
android/local.properties
ios/build/
ios/Pods/
ios/*.xcworkspace/
*.xcuserdata/

# Internal reference docs / vendor mapping — keep local, never commit.
docs/
